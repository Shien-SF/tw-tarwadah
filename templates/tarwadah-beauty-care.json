            },
            {
              "quote": {
                "ar": "إلغاء الضوضاء لطيف لدرجة أنك تنسى أنه يعمل.",
                "en": "Noise cancellation so gentle, you forget it’s working."
              },
              "author": {
                "ar": "ديفيد كيم",
                "en": "David Kim"
