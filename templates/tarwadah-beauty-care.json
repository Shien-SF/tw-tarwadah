            },
            {
              "quote": {
                "ar": "كل نغمة تبدو شخصية، كأنها تعرف من يستمع.",
                "en": "Every note sounds personal, like it knows who’s listening."
              },
              "author": {
                "ar": "ديفيد كيم",
                "en": "David Kim"
